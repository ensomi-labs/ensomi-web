{
  "name": "@ensomi/runtime",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "fflate": "0.8.2",
    "onnxruntime-web": "1.23.2"
  },
  "devDependencies": {
    "esbuild": "0.25.9",
    "playwright": "1.54.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "scripts": {
    "vendor": "scripts/vendor.sh",
    "same-as-ts": "node --import tsx checks/same-as-ts.mjs",
    "typecheck": "tsc --noEmit",
    "build:site": "esbuild ../../site/app.ts ../../site/worker.ts --bundle --format=esm --target=es2022 --minify --outdir=../../public --log-level=warning && cp pkg/ensomi_generate_wasm_bg.wasm ../../public/ensomi-runtime.wasm && rm -rf ../../public/resampler && cp -R assets ../../public/resampler",
    "typecheck:site": "tsc -p ../../site",
    "serve:site": "node ../../site/serve.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "pkg",
    "assets",
    "provenance.json",
    "LICENSE",
    "README.md"
  ]
}
